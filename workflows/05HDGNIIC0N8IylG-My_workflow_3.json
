      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst out = items.map(it => {\n  const data = { ...(it.json ?? it) };\n\n  // Aseguramos que existe un título\n  const title = data.title || '';\n\n  // Busca \"open source\" sin distinguir mayúsculas\n  if (title.toLowerCase().includes(\"open source\")) {\n    // Evita duplicar si ya está puesto\n    if (!title.startsWith(\"UDIA:\")) {\n      data.title = `UDIA: ${title}`;\n    }\n  }\n\n  return { ...it, json: data };\n});\n\nreturn out;\n"
      },
