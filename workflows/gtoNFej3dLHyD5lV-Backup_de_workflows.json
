    {
      "parameters": {
        "jsCode": "// Workflow actual: viene del Loop Over Items\nconst workflow = $node[\"Loop Over Items\"].json;\n\n// Contenido actual a guardar en GitHub\nconst currentContent = JSON.stringify(workflow, null, 2);\n\n// Datos del nodo \"Get a file\"\nconst getFileData = $node[\"Get a file\"].json;\n\n// Contenido anterior en GitHub (si existe)\nlet previousContent = \"\";\n\nif (getFileData && getFileData.content && getFileData.encoding === \"base64\") {\n  previousContent = Buffer.from(getFileData.content, \"base64\").toString(\"utf8\");\n}\n\n// Calcular github_status\nlet github_status;\n\nif (!previousContent) {\n  github_status = \"new\";\n} else if (previousContent !== currentContent) {\n  github_status = \"different\";\n} else {\n  github_status = \"same\";\n}\n\n// Devolvemos SOLO lo que necesitamos\nreturn [\n  {\n    json: {\n      ...workflow,       // id, name, nodes, etc.\n      currentContent,\n      previousContent,\n      github_status\n    }\n  }\n];\n"
      },
